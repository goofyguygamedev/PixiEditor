<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dock="clr-namespace:PixiEditor.ViewModels.Dock"
             xmlns:document="clr-namespace:PixiEditor.ViewModels.Document"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="450"
             x:Class="PixiEditor.Views.Dock.HistoryDockView"
             x:DataType="dock:HistoryDockViewModel">
    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding DocumentManagerSubViewModel.ActiveDocument.History}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="document:HistoryEntryViewModel">
                    <Button Command="{Binding JumpCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,3"
                            Opacity="{Binding Dim}">
                        <TextBlock Text="{Binding Label}" FontWeight="{Binding Weight}" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
