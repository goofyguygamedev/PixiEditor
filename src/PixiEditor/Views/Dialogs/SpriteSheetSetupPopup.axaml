<dialogs:PixiEditorPopup x:Class="PixiEditor.Views.Dialogs.SpriteSheetSetupPopup"
                         x:ClassModifier="internal"
                         xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:ui="clr-namespace:PixiEditor.UI.Common.Localization;assembly=PixiEditor.UI.Common"
                         xmlns:dialogs="clr-namespace:PixiEditor.Views.Dialogs"
                         xmlns:controls="clr-namespace:PixiEditor.UI.Common.Controls;assembly=PixiEditor.UI.Common"
                         mc:Ignorable="d"
                         d:Title="Sprite sheet" Height="260" Width="380" MinHeight="260" MinWidth="380"
                         CanResize="False"
                         CanMinimize="False"
                         x:Name="popup"
                         ui:Translator.Key="SPRITE_SHEET_SETUP_TITLE">

    <DockPanel Margin="20,10,20,15">
        <TextBlock DockPanel.Dock="Top"
                   Foreground="{DynamicResource ThemeForegroundBrush}"
                   FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="{Binding ElementName=popup, Path=ResultDescription}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="80" Margin="0,0,10,0" Click="CancelButton_Click" ui:Translator.Key="CANCEL" />
            <Button Width="80" IsDefault="True" Click="OkButton_Click" ui:Translator.Key="APPLY" />
        </StackPanel>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="140,*" VerticalAlignment="Top">
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,8"
                       Foreground="{DynamicResource ThemeForegroundBrush}"
                       ui:Translator.Key="SPRITE_SHEET_FRAME_WIDTH" />
            <controls:NumberInput Grid.Row="0" Grid.Column="1" Min="1" Max="4096" Decimals="0" Margin="0,0,0,8"
                                  Value="{Binding ElementName=popup, Path=FrameWidth, Mode=TwoWay}" />

            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,8"
                       Foreground="{DynamicResource ThemeForegroundBrush}"
                       ui:Translator.Key="SPRITE_SHEET_FRAME_HEIGHT" />
            <controls:NumberInput Grid.Row="1" Grid.Column="1" Min="1" Max="4096" Decimals="0" Margin="0,0,0,8"
                                  Value="{Binding ElementName=popup, Path=FrameHeight, Mode=TwoWay}" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,8"
                       Foreground="{DynamicResource ThemeForegroundBrush}"
                       ui:Translator.Key="SPRITE_SHEET_FRAME_COUNT" />
            <controls:NumberInput Grid.Row="2" Grid.Column="1" Min="1" Max="512" Decimals="0" Margin="0,0,0,8"
                                  Value="{Binding ElementName=popup, Path=FrameCount, Mode=TwoWay}" />

            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeForegroundBrush}"
                       ui:Translator.Key="SPRITE_SHEET_COLUMNS" />
            <controls:NumberInput Grid.Row="3" Grid.Column="1" Min="1" Max="512" Decimals="0"
                                  Value="{Binding ElementName=popup, Path=Columns, Mode=TwoWay}" />
        </Grid>
    </DockPanel>
</dialogs:PixiEditorPopup>
